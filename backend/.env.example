# ==============================================================================
# AI Phishing Email Detection System - Backend Environment Configuration
# ==============================================================================

# Server settings
HOST=127.0.0.1
PORT=8000

# Google OAuth 2.0 Credentials (From Google Cloud Console)
# 1. Go to https://console.cloud.google.com/
# 2. Enable the "Gmail API"
# 3. Create OAuth 2.0 Client ID (Web Application)
# 4. Set Authorized Redirect URI: http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Frontend URL for redirecting after OAuth authentication
FRONTEND_REDIRECT_URL=http://localhost:5173

# Secret key for encrypting OAuth tokens at rest (Fernet key or arbitrary secure string)
SECRET_KEY=k7fN1u0kQ9Y3Z4_X2vA6bC8eD0fG2hJ4kL6mN8pQ0sU=

# MongoDB Connection String (Local MongoDB or MongoDB Atlas URI)
# If local MongoDB is not running, the system will gracefully fall back to local storage
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=phishing_detection_db
