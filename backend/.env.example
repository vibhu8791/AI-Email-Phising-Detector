# ==============================================================================
# AI Phishing Email Detection System - Backend Environment Configuration
# ==============================================================================

# Environment Mode ("development" or "production")
# In "production", persistent database connection is strictly enforced.
ENVIRONMENT=development

# Server Host and Port
HOST=127.0.0.1
PORT=8000

# Allowed CORS Origins (comma-separated for multiple origins)
# In production, set this to your exact frontend origin (e.g., https://your-domain.com)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Google OAuth 2.0 Credentials (From Google Cloud Console: https://console.cloud.google.com/)
# 1. Enable "Gmail API"
# 2. Configure OAuth Consent Screen & Branding
# 3. Create Credentials > OAuth 2.0 Client ID (Web Application)
# 4. Set Authorized Redirect URI: http://localhost:8000/api/auth/google/callback (or https://api.your-domain.com/api/auth/google/callback)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Frontend URL for redirecting after OAuth authentication
# In production, set to your hosted frontend URL (e.g., https://your-domain.com)
FRONTEND_REDIRECT_URL=http://localhost:5173

# Cryptographic Keys (Do NOT commit real keys to version control!)
# Generate a strong 32-byte key for production (e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`)
SECRET_KEY=k7fN1u0kQ9Y3Z4_X2vA6bC8eD0fG2hJ4kL6mN8pQ0sU=
JWT_SECRET=your_secure_random_jwt_signing_secret_here
JWT_EXPIRATION_HOURS=168

# Persistent Database Configuration (MongoDB or MongoDB Atlas)
# In production, REQUIRE_PERSISTENT_DB=true prevents silent fallback to local file storage.
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=phishing_detection_db
REQUIRE_PERSISTENT_DB=false
