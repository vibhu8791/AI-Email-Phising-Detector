# Backend Environment
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Google OAuth 2.0 Credentials (Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
FRONTEND_REDIRECT_URL=http://localhost:5173

# Security & Cryptography
SECRET_KEY=k7fN1u0kQ9Y3Z4_X2vA6bC8eD0fG2hJ4kL6mN8pQ0sU=
JWT_SECRET=your_secure_random_jwt_signing_secret_here
JWT_EXPIRATION_HOURS=168

# Database (MongoDB / MongoDB Atlas)
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=phishing_detection_db
REQUIRE_PERSISTENT_DB=false

# Frontend (Vite)
VITE_API_URL=http://127.0.0.1:8000/api
VITE_WS_URL=ws://127.0.0.1:8000/ws/alerts
