# ==============================================================================
# AI Phishing Email Detection System - Frontend Environment Configuration
# ==============================================================================

# Backend REST API Base URL
# Development default: http://127.0.0.1:8000/api
# Production example: https://api.your-domain.com/api
VITE_API_URL=http://127.0.0.1:8000/api

# WebSocket Real-Time Alert Stream URL
# Development default: ws://127.0.0.1:8000/ws/alerts
# Production example: wss://api.your-domain.com/ws/alerts
VITE_WS_URL=ws://127.0.0.1:8000/ws/alerts
